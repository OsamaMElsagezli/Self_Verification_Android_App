<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/passportRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Design-time safe placeholder: NOT inflated in the Layout Editor -->
    <ViewStub
        android:id="@+id/previewStub"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- PNG Outline Overlay (visual only) -->
    <com.example.myapp.PassportOutlineOverlay
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Bottom instruction + buttons (bigger touch targets) -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:background="#66000000">

        <TextView
            android:id="@+id/instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Align passport inside the frame and press Scan" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:text="Back" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/btnCapture"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:text="Scan Passport" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
